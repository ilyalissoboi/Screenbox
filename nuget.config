<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<!-- AirPlay casting: the SendAirPlay2 package until it is on nuget.org;
		     scripts/Get-AirPlayPackage.ps1 fills this folder. -->
		<add key="packages-airplay" value="packages-airplay" />
	</packageSources>
</configuration>